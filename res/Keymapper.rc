#include <windows.h>
#include "resource.h"

IDI_APP     ICON "keymapper.ico"
IDI_PAUSED  ICON "keymapper-paused.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "Keymapper.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Keymapper - keyboard remapping for Windows"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "Keymapper"
            VALUE "LegalCopyright", "Copyright (c) 2026 hanul. MIT License."
            VALUE "OriginalFilename", "Keymapper.exe"
            VALUE "ProductName", "Keymapper"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
